# Reuse a trusted local runtime; compile dist/<arch>/p3y with embedui first.
ARG P3Y_BASE_IMAGE=p3y/p3y:local
FROM ${P3Y_BASE_IMAGE}
ARG TARGETARCH=amd64
# Clear inherited runtime credentials; deployment supplies them through Compose.
ENV OPENAI_API_KEY="" ANTHROPIC_API_KEY="" P3Y_LLM_PROVIDER="" P3Y_LLM_MODEL="" P3Y_LLM_BASE_URL="" P3Y_LLM_PROXY=""
COPY dist/${TARGETARCH}/p3y /app/p3y
COPY start.sh /app/start.sh
COPY skills/ /app/skills/
RUN rm -f /app/config.json /app/jwt.key /app/p3y.upgrade.json /app/p3y.new /app/p3y.old /app/p3y.failed && chmod +x /app/p3y /app/start.sh
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
